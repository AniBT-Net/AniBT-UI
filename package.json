{
  "name": "anibt-ui",
  "version": "0.1.0",
  "private": true,
  "description": "AniBT UI — the AniBT 「贴纸手账」 component library, distributed as a shadcn registry (@anibt).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "registry:theme": "node scripts/registry-theme.mjs",
    "registry:build": "node scripts/registry-theme.mjs && shadcn build",
    "typecheck": "node scripts/registry-theme.mjs --check && next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "^15.4.6",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "shadcn": "4.21.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
