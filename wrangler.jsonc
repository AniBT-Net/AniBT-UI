{
  // Static export only. This file stops `wrangler deploy` from detecting
  // Next.js and installing the OpenNext adapter. `out/` is gitignored;
  // `postinstall` creates it when WORKERS_CI=1. The `name` must match
  // the Worker in the Cloudflare dashboard.
  "name": "anibt-ui",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out",
    // Next writes `page.html`, not `page/index.html`.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
